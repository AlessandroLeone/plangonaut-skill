{
  "name": "plangonaut",
  "version": "0.3.0-alpha.6",
  "description": "Human-governed project discovery, planning, multi-agent orchestration, and durable resume.",
  "type": "module",
  "bin": {
    "plangonaut": "lib/bin/plangonaut.js"
  },
  "files": [
    "lib",
    "skills/plangonaut/SKILL.md",
    "skills/plangonaut/VERSION",
    "skills/plangonaut/agents",
    "skills/plangonaut/assets",
    "skills/plangonaut/references",
    "skills/plangonaut/schemas",
    "dist/plangonaut-portable.md",
    "README.md",
    "CHANGELOG.md",
    "VERSION",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm test && npm run pack:check",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "portable": "node lib/bin/plangonaut.js export --target portable --output-dir dist",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agent-skills",
    "project-planning",
    "multi-agent",
    "orchestration",
    "codex",
    "claude",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlessandroLeone/plangonaut-skill.git"
  },
  "bugs": {
    "url": "https://github.com/AlessandroLeone/plangonaut-skill/issues"
  },
  "homepage": "https://plangonaut.com",
  "license": "Apache-2.0",
  "private": false,
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
